# توكن البوت الخاص بك من @BotFather على تيليجرام
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# معرف المشرف الخاص بك على تيليجرام (يمكنك الحصول عليه بإرسال /id للبوت) للإذاعة الجماعية (BC)
ADMIN_ID=6436816730

# أقصى حجم للملف بالميجابايت (حد تيليجرام للبوتات 50MB، ونوصي بـ 48 كحد أمان)
MAX_FILE_SIZE_MB=48

# مسار اختياري لملف الكوكيز (cookies.txt) لتجاوز قيود يوتيوب وإنستغرام
COOKIES_FILE=cookies.txt

# مجلد التخزين المؤقت للملفات أثناء التحميل
DOWNLOAD_DIR=downloads

# منفذ خادم فحص الصحة عند الرفع على منصات السحاب مثل Render (تلقائي 10000)
PORT=10000
